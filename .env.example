# DeepSeek API Key（必填。仅服务端使用，不会暴露到浏览器）
DEEPSEEK_API_KEY=

# DeepSeek 模型名称（可选，默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase 项目 URL（NEXT_PUBLIC_ 前缀会发送到浏览器，请使用项目 API URL）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 发布密钥（publishable key，可安全用于前端）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 免费用户每日「智能分析」次数上限（默认 5）
FREE_DAILY_ANALYSIS_LIMIT=5

# 免费用户每日「AI 简历优化」次数上限（默认 2）
FREE_DAILY_RESUME_OPTIMIZATION_LIMIT=2

# 免限用户邮箱白名单（逗号分隔，大小写不敏感；这些账号分析/优化均不限次）
UNLIMITED_USER_EMAILS=mouringx@126.com

# 后台 worker（Supabase Edge Function）完整 URL。
# 设置后：AI 分析/优化进入后台队列，Netlify 路由只做秒级入队与状态查询（不再受 10s 超时限制）。
# 留空：本地开发时走同步调用（pnpm dev 无超时限制，可直接使用）。
# 示例：https://<project-ref>.supabase.co/functions/v1/resume-worker
RESUME_WORKER_URL=
