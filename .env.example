# DeepSeek API Key（必填。仅服务端使用，不会暴露到浏览器）
DEEPSEEK_API_KEY=

# DeepSeek 模型名称（可选，默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase 项目 URL（NEXT_PUBLIC_ 前缀会发送到浏览器，请使用项目 API URL）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 发布密钥（publishable key，可安全用于前端）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 免费用户每日分析次数上限（默认 5）
FREE_DAILY_ANALYSIS_LIMIT=5
